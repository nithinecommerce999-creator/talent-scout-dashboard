    {
      "parameters": {
        "jsCode": "// Collect all run_ids from Supabase response\n// Returns empty array → workflow stops naturally if no runs\nconst items = $input.all();\nlet runs = [];\nif (items.length === 1 && Array.isArray(items[0].json)) {\n  runs = items[0].json;\n} else {\n  runs = items.map(i => i.json).filter(r => r && r.run_id);\n}\nconst run_ids = runs.map(r => r.run_id).filter(Boolean);\nif (run_ids.length === 0) {\n  console.log('[INFO] No runs — stopping');\n  return [];\n}\nconsole.log(`[INFO] Migrating ${run_ids.length} runs`);\nreturn [{ json: { run_ids } }];"
      },
      "id": "ce367ac1-6ad6-4174-85e7-5a1dbea7a559",
      "name": "Build run_ids",
