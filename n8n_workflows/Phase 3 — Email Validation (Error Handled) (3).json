      "id": "aa67e056-49e8-489a-927d-424847b949a3",
      "name": "When Executed by Another Workflow"
    },
    {
      "parameters": {
        "jsCode": "// Extract poc_id + selected_email from each incoming POC record.\n// poc_id is kept as a Number (bigint-compatible) to match poc_leads.poc_id FK.\n// Skips records with no selected_email.\nconst items = $input.all();\nconst result = [];\n\nfor (const item of items) {\n  const data = item.json;\n  const email = (data.selected_email || '').trim();\n  const pocId  = parseInt(data.poc_id, 10);\n  if (email && !isNaN(pocId)) {\n    result.push({\n      json: {\n        poc_id: pocId,\n        email\n      }\n    });\n  }\n}\n\nreturn result;"
      },
      "id": "eecfe4b3-d703-4c40-b326-e1c1ebc8a8cc",
      "name": "Extract POC Emails",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -784,
        -512
      ]
    },
    {
      "parameters": {
        "batchSize": 20,
        "options": {}
      },
      "id": "7f809075-0e0d-4e53-99fa-80432738cb08",
      "name": "Split In Batches",
      "type": "n8n-nodes-base.splitInBatches",
      "typeVersion": 3,
      "position": [
        -560,
        -512
      ]
    },
    {
      "parameters": {
        "jsCode": "// Aggregates all items in the current batch into:\n//   - emails[]       → the array sent to Apify\n//   - timeout        → actor timeout in seconds (as required by the actor's input schema)\n//   - emailToPocId{} → lookup map used after Apify responds\nconst items = $input.all();\nconst emails = [];\nconst emailToPocId = {};\n\nfor (const item of items) {\n  const email = item.json.email;\n  const pocId  = item.json.poc_id;\n  if (email) {\n    emails.push(email);\n    emailToPocId[email] = pocId;\n  }\n}\n\nreturn [{\n  json: {\n    emails,\n    timeout: 10,\n    emailToPocId\n  }\n}];"
      },
      "id": "7545844c-c941-43b7-a281-7617966db695",
      "name": "Build Batch Input",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -336,
        -576
      ]
    },
    {
      "parameters": {
        "jsCode": "// Join each Apify result with its poc_id using the email as the key.\n// poc_id is cast to Number to match the bigint FK on poc_leads.poc_id.\nconst items = $input.all();\nconst emailToPocId = $('Build Batch Input').first().json.emailToPocId;\n\nreturn items.map(item => {\n  const email = item.json.email || '';\n  const rawId = emailToPocId[email];\n  return {\n    json: {\n      poc_id:        rawId != null ? parseInt(rawId, 10) : null,\n      email:         email,\n      email_quality: item.json.email_quality || null,\n      email_result:  item.json.email_result  || null,\n      subresult:     item.json.subresult     || null,\n      validated_at:  new Date().toISOString()\n    }\n  };\n});"
      },
      "id": "664987de-9d5d-438c-bdd1-feef16cb26b7",
      "name": "Map Results to POC ID",
