      "parameters": { "jsCode": "const poc = $input.first().json;\nfunction render(str) { return (str || '').replace(/\\{first_name\\}/g, poc.first_name || 'there').replace(/\\{full_name\\}/g, poc.full_name || poc.first_name || 'there').replace(/\\{company_name\\}/g, poc.company_name || 'your company').replace(/\\{job_title\\}/g, poc.hiring_job_title || '').replace(/\\{poc_title\\}/g, poc.poc_title || '').replace(/\\{location\\}/g, poc.job_location || ''); }\nreturn [{ json: { ...poc, rendered_subject: render(poc.template_subject), rendered_body: render(poc.template_body) }}];" },
