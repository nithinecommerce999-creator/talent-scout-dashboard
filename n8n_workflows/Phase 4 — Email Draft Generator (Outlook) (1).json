    {
      "parameters": { "jsCode": "const poc = $('Render Email').first().json;\nconst draftResult = $input.first().json;\nconst draftError  = draftResult.error;\nconst draftId = draftResult.id || null;\nconst status  = draftError ? 'failed' : 'draft';\nreturn [{ json: { run_id: poc.run_id, ranked_poc_id: poc.ranked_poc_id, poc_id: poc.poc_id, to_email: poc.to_email, to_name: poc.full_name, company_name: poc.company_name, hiring_job_title: poc.hiring_job_title, poc_title: poc.poc_title, job_location: poc.job_location, subject: poc.rendered_subject, body: poc.rendered_body, template_id: poc.template_id, template_name: poc.template_name, status, provider: poc.send_provider, draft_id: draftId, outlook_draft_id: poc.send_provider === 'outlook' ? draftId : null }}];" },
