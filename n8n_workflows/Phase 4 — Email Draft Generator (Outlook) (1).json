    {
      "parameters": {
        "jsCode": "// Gather all upstream data\nconst pocs       = $('Fetch Validated POCs').all().map(i => i.json);\nconst validations = $('Fetch Email Validations').all().map(i => i.json);\nconst jobs        = $('Fetch Job Details').all().map(i => i.json);\nconst localities  = $('Fetch Company Localities').all().map(i => i.json);\nconst run_id      = $('Extract IDs').first().json.run_id;\n\n// Build lookup maps\nconst validMap = {};\nfor (const v of validations) validMap[v.poc_id] = v;\n\nconst jobMap = {};\nfor (const j of jobs) {\n  if (!jobMap[j.company_id]) jobMap[j.company_id] = j;\n}\n\nconst localMap = {};\nfor (const l of localities) localMap[l.company_uid] = l.company_locality || '';\n\n// Build one item per POC with valid email\nconst queue = [];\nfor (const poc of pocs) {\n  const validation = validMap[poc.poc_id];\n  if (!validation) continue;\n  if (!poc.selected_email) continue;\n\n  const job      = jobMap[poc.company_uid] || {};\n  const location = localMap[poc.company_uid] || '';\n  const firstName = poc.first_name\n    || (poc.full_name || '').split(' ')[0]\n    || 'there';\n\n  queue.push({ json: {\n    ranked_poc_id:    poc.ranked_poc_id,\n    poc_id:           poc.poc_id,\n    first_name:       firstName,\n    full_name:        poc.full_name || poc.first_name || '',\n    poc_title:        poc.job_title || '',\n    to_email:         poc.selected_email,\n    company_name:     poc.company_name || '',\n    company_uid:      poc.company_uid,\n    hiring_job_title: job.job_title || '',\n    job_location:     location,\n    run_id,\n    email_quality:    validation.email_quality || '',\n  }});\n}\n\nif (queue.length === 0) {\n  throw new Error('No POCs with validated emails (email_result=ok) found for this run.');\n}\n\nreturn queue;"
      },
      "id": "a11ab281-83b6-43af-8410-6bb958fd9059",
      "name": "Build Draft Queue",
      "type": "n8n-nodes-base.code",
