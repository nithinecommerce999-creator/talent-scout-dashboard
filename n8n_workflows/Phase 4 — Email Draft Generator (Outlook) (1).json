    {
      "parameters": {
        "jsCode": "// Get the POC data from Render Email node\nconst poc = $('Render Email').first().json;\n\n// Get Gmail result (may have error if Gmail failed)\nconst gmailResult = $input.first().json;\nconst gmailError  = gmailResult.error;\n\n// Gmail draft ID is in gmailResult.id\nconst gmailDraftId = gmailResult.id || null;\nconst status = gmailError ? 'failed' : 'draft';\n\nreturn [{ json: {\n  run_id:           poc.run_id,\n  ranked_poc_id:    poc.ranked_poc_id,\n  poc_id:           poc.poc_id,\n  to_email:         poc.to_email,\n  to_name:          poc.full_name,\n  company_name:     poc.company_name,\n  hiring_job_title: poc.hiring_job_title,\n  poc_title:        poc.poc_title,\n  job_location:     poc.job_location,\n  subject:          poc.rendered_subject,\n  body:             poc.rendered_body,\n  template_id:      poc.template_id,\n  template_name:    poc.template_name,\n  status,\n  gmail_draft_id:   gmailDraftId,\n}}];"
      },
