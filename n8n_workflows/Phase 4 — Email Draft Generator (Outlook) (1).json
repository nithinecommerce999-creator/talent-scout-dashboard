    {
      "parameters": { "jsCode": "const queue     = $('Build Draft Queue').all().map(i => i.json);\nconst templates = $('Fetch Active Templates').all().map(i => i.json).filter(t => t.body && t.subject);\nif (!templates.length) throw new Error('No active email templates found in database.');\nconst history = $('Fetch Recent Template History').all().map(i => i.json);\nconst lastUsedByCompany = {};\nfor (const h of history) { if (h.company_uid && !lastUsedByCompany[h.company_uid]) lastUsedByCompany[h.company_uid] = h.template_id; }\nfunction shuffle(arr) { const a = [...arr]; for (let i = a.length - 1; i > 0; i--) { const j = Math.floor(Math.random() * (i + 1)); [a[i], a[j]] = [a[j], a[i]]; } return a; }\nconst pool = shuffle(templates);\nlet poolIndex = 0;\nconst lastUsedThisRun = {};\nfunction pickTemplate(companyUid) { const avoid = new Set([lastUsedByCompany[companyUid], lastUsedThisRun[companyUid]].filter(Boolean)); for (let attempts = 0; attempts < templates.length; attempts++) { const candidate = pool[poolIndex % pool.length]; poolIndex++; if (templates.length === 1 || !avoid.has(candidate.template_id)) { lastUsedThisRun[companyUid] = candidate.template_id; return candidate; } } const fallback = pool[poolIndex % pool.length]; poolIndex++; lastUsedThisRun[companyUid] = fallback.template_id; return fallback; }\nconst ACTIVE_PROVIDERS = ['gmail'];\nreturn queue.map((item, idx) => { const template = pickTemplate(item.company_uid); return { json: { ...item, template_id: template.template_id, template_name: template.name, template_subject: template.subject, template_body: template.body, send_provider: ACTIVE_PROVIDERS[idx % ACTIVE_PROVIDERS.length] }}; });" },
