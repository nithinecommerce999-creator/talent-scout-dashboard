    {
      "parameters": { "jsCode": "const MAX_DRAFTS_PER_COMPANY = 3;\n\nconst pocs = $input.all().map(i => i.json);\nif (!pocs.length) throw new Error('No POCs found for run_id: ' + $('Extract Run ID').first().json.run_id);\n\nconst validations = $('Fetch Email Validations').all().map(i => i.json);\nconst jobs        = $('Fetch Job Details').all().map(i => i.json);\nconst localities  = $('Fetch Company Localities').all().map(i => i.json);\nconst run_id      = $('Extract IDs').first().json.run_id;\n\nconst validMap = {};\nfor (const v of validations) validMap[v.poc_id] = v;\n\nconst jobMap = {};\nfor (const j of jobs) { if (!jobMap[j.company_id]) jobMap[j.company_id] = j; }\n\nconst localMap = {};\nfor (const l of localities) localMap[l.company_uid] = l.company_locality || '';\n\nconst companyCounts = {};\nconst queue = [];\n\nfor (const poc of pocs) {\n  const validation = validMap[poc.poc_id];\n  if (!validation) continue;\n  if (!poc.selected_email) continue;\n\n  const uid = poc.company_uid || 'unknown';\n  companyCounts[uid] = (companyCounts[uid] || 0) + 1;\n  if (companyCounts[uid] > MAX_DRAFTS_PER_COMPANY) continue;\n\n  const job      = jobMap[poc.company_uid] || {};\n  const location = localMap[poc.company_uid] || '';\n  const firstName = poc.first_name || (poc.full_name || '').split(' ')[0] || 'there';\n\n  queue.push({ json: { ranked_poc_id: poc.ranked_poc_id, poc_id: poc.poc_id, first_name: firstName, full_name: poc.full_name || poc.first_name || '', poc_title: poc.job_title || '', to_email: poc.selected_email, company_name: poc.company_name || '', company_uid: poc.company_uid, hiring_job_title: job.job_title || '', job_location: location, run_id, email_quality: validation.email_quality || '' }});\n}\n\nif (queue.length === 0) throw new Error('No POCs with validated emails (email_result=ok) found for this run.');\nreturn queue;" },
