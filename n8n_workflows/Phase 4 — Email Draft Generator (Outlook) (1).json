    {
      "parameters": {
        "jsCode": "const poc = $input.first().json;\n\n// Get active templates from upstream node\nconst templates = $('Fetch Active Templates').all().map(i => i.json)\n  .filter(t => t.body && t.subject);\n\nif (!templates.length) throw new Error('No active email templates found in database.');\n\n// Pick a random template\nconst template = templates[Math.floor(Math.random() * templates.length)];\n\n// Simple variable substitution\nfunction render(str) {\n  return (str || '')\n    .replace(/\\{first_name\\}/g, poc.first_name || 'there')\n    .replace(/\\{job_title\\}/g,  poc.hiring_job_title || '')\n    .replace(/\\{location\\}/g,   poc.job_location || '');\n}\n\nconst rendered_subject = render(template.subject);\nconst rendered_body    = render(template.body);\n\nreturn [{ json: {\n  ...poc,\n  rendered_subject,\n  rendered_body,\n  template_id:   template.template_id,\n  template_name: template.name,\n}}];"
      },
      "id": "ab17c57b-bdfe-4c0c-bfe0-ae4770008832",
