    {
      "parameters": {
        "jsCode": "const scraped   = $input.all();\nconst originals = $('Split In Batches').all();\n\n// Build lookup: normalised URL -> job_refs array\nconst urlMap = {};\nfor (const item of originals) {\n  const key = (item.json.recruiter_profile || '')\n    .trim().toLowerCase().replace(/\\/$/,  '');\n  urlMap[key] = item.json.job_refs || [];\n}\n\nconst result = [];\n\nfor (const item of scraped) {\n  const rawUrl  = (item.json.linkedinUrl || '').trim();\n  const key     = rawUrl.toLowerCase().replace(/\\/$/,  '');\n  const jobRefs = urlMap[key] || [{}];\n\n  // ── Location ─────────────────────────────────────────────────────────────\n  // Actual path: location.parsed.city / location.parsed.state\n  const city  = item.json.location?.parsed?.city  ?? null;\n  const state = item.json.location?.parsed?.state ?? null;\n\n  // ── Email ─────────────────────────────────────────────────────────────────\n  // emails[] array — prefer deliverable+valid, fall back to first entry\n  const emailObj = item.json.emails?.find(e => e.deliverable === true && e.status === 'valid')\n                ?? item.json.emails?.[0]\n                ?? null;\n  const email = emailObj?.email ?? null;\n\n  // ── Company website ───────────────────────────────────────────────────────\n  // companyWebsites[] array\n  const scraped_company_website = item.json.companyWebsites?.[0]?.url ?? null;\n\n  // ── Current position fields ───────────────────────────────────────────────\n  const currentPos             = item.json.currentPosition?.[0] ?? null;\n  const scraped_company_name   = currentPos?.companyName ?? null;\n  const job_title              = currentPos?.position    ?? null;\n\n  // ── Identity ──────────────────────────────────────────────────────────────\n  // No fullName field in response — construct from firstName + lastName\n  const first_name   = item.json.firstName ?? null;\n  const last_name    = item.json.lastName  ?? null;\n  const full_name    = (first_name || last_name)\n                       ? `${first_name ?? ''} ${last_name ?? ''}`.trim()\n                       : null;\n\n  // linkedin_id: actor returns objectUrn (numeric urn) at root level\n  const linkedin_id  = item.json.objectUrn ?? item.json.publicIdentifier ?? null;\n\n  // ── Engagement ────────────────────────────────────────────────────────────\n  // connectionsCount / followerCount (not connections / followers)\n  const connections  = item.json.connectionsCount ?? null;\n  const followers    = item.json.followerCount    ?? null;\n\n  // ── Flags ─────────────────────────────────────────────────────────────────\n  // premium / verified (not isPremium / isVerified)\n  const is_premium   = item.json.premium  ?? null;\n  const is_verified  = item.json.verified ?? null;\n\n  // ── Profile picture ───────────────────────────────────────────────────────\n  // profilePicture.url (not profilePicHighQuality / profilePic)\n  const profile_pic  = item.json.profilePicture?.url\n                    ?? item.json.photo?.url\n                    ?? null;\n\n  // Expand: one row per job_ref\n  for (const ref of jobRefs) {\n    result.push({\n      json: {\n        // Per-job association\n        job_id:         ref.job_id         ?? null,\n        company_uid:    ref.company_uid    ?? null,\n        run_id:         ref.run_id         ?? null,\n        run_label:      ref.run_label      ?? null,\n        recruiter_name: ref.recruiter_name ?? null,\n\n        // Core identity\n        profile_linkedin: rawUrl,\n        linkedin_id,\n        first_name,\n        last_name,\n        full_name,\n        job_title,\n        headline:  item.json.headline ?? null,\n\n        // Contact\n        email,\n        mobile_no: null,   // field not present in this actor's response\n\n        // Location\n        city,\n        state,\n\n        // Company info from scrape\n        scraped_company_name,\n        scraped_company_website,\n\n        // Engagement signals\n        connections,\n        followers,\n        is_premium,\n        is_verified,\n        profile_pic\n      }\n    });\n  }\n}\n\nreturn result;"
      },
