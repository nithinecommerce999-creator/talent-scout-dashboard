    {
      "parameters": {
        "jsCode": "const raw = $input.first().json;\n\nconst records = (raw.items && Array.isArray(raw.items)) ? raw.items\n              : Array.isArray(raw)                       ? raw\n              : $input.all().map(i => i.json);\n\n// Group all job references by unique recruiter URL\n// One URL can map to multiple job_ids if recruiter posted several jobs\nconst urlMap = {};\nfor (const record of records) {\n  const url = (record.recruiter_profile || '').trim();\n  if (!url) continue;\n\n  if (!urlMap[url]) {\n    urlMap[url] = {\n      recruiter_profile: url,\n      job_refs: []\n    };\n  }\n\n  urlMap[url].job_refs.push({\n    job_id:         record.job_id,\n    company_uid:    record.company_id,\n    run_id:         record.run_id,\n    run_label:      record.run_label,\n    recruiter_name: record.recruiter_name\n  });\n}\n\n// One item per unique URL — each carries full job_refs array\nreturn Object.values(urlMap).map(v => ({ json: v }));"
      },
      "id": "599d4f5a-6a6e-4f30-a5fd-41bac1fec930",
